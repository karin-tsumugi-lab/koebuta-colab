+std::string trim_ascii(const char * raw) {
+    if (!raw) return {};
+    std::string s(raw);
+    auto is_ws = [](unsigned char ch) { return std::isspace(ch) != 0; };
+    while (!s.empty() && is_ws((unsigned char) s.front())) s.erase(s.begin());
+    while (!s.empty() && is_ws((unsigned char) s.back())) s.pop_back();
+    return s;
+}
