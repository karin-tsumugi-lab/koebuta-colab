+int64_t parse_env_i64(const char * name, const char * raw) {
+    const std::string s = trim_ascii(raw);
+    if (s.empty()) return 0;
+    errno = 0;
+    char * end = nullptr;
+    const long long parsed = std::strtoll(s.c_str(), &end, 10);
+    if (errno == ERANGE || end == s.c_str() || *end != '\0') {
+        throw Error(Fault::InvalidArgument, std::string(name) + " must be a base-10 integer");
+    }
+    return (int64_t) parsed;
+}
+
+double parse_env_pos_double(const char * name, const char * raw, double fallback) {
+    const std::string s = trim_ascii(raw);
+    if (s.empty()) return fallback;
+    errno = 0;
+    char * end = nullptr;
+    const double v = std::strtod(s.c_str(), &end);
+    if (errno != 0 || end == s.c_str() || *end != '\0' || !std::isfinite(v) || v <= 0.0 || v > 1e6) {
+        throw Error(Fault::InvalidArgument, std::string(name) + " must be a finite positive number <= 1e6");
+    }
+    return v;
+}
