+                 (((unsigned char) spoken[i + 2] & 0x3Fu) << 6) | ((unsigned char) spoken[i + 3] & 0x3Fu);
+            len = 4;
+        } else if (c >= 0xE0 && i + 2 < spoken.size()) {
+            cp = ((c & 0x0Fu) << 12) | (((unsigned char) spoken[i + 1] & 0x3Fu) << 6) | ((unsigned char) spoken[i + 2] & 0x3Fu);
+            len = 3;
+        } else if (c >= 0xC0 && i + 1 < spoken.size()) {
+            cp = ((c & 0x1Fu) << 6) | ((unsigned char) spoken[i + 1] & 0x3Fu);
+            len = 2;
+        }
+        i += len;
+        if (cp == '[') { ++depth_square; ++spans; continue; }
+        if (cp == ']') { if (depth_square > 0) --depth_square; continue; }
+        if (cp == '<') { ++depth_angle; ++spans; continue; }
+        if (cp == '>') { if (depth_angle > 0) --depth_angle; continue; }
+        if (depth_square > 0 || depth_angle > 0) continue;
